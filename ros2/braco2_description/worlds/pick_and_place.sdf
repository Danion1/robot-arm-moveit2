<?xml version="1.0" ?>
<!-- Mundo do pick and place (Projeto 2). Base: empty.sdf do gz-sim 8 (física,
     comandos, cena, contato, sol, chão) + o OBJETO a pegar.

     O chão (z = 0) é a mesa: a base do braço está presa nele pela junta fixa
     world -> base_link do URDF.

     Objeto: cubo de PLA de 20 mm, maciço.
       massa = 1,24 g/cm³ (ficha do PLA, cad/lib/dados_materiais.py) x 8 cm³ = 9,92 g,
       bem abaixo da carga útil de 56 g com o braço esticado (massa.py);
       inércia de cubo = m·a²/6 = 0,00992 x 0,02² / 6 = 6,61e-7 kg·m².
       atrito mu = 0,5: ASSUMIDO (PLA sobre PLA; a ficha não traz atrito).
     Posição: (160, 60) mm, onde a conferência do MoveIt2 já planejou a pega;
     girado em Z pelo mesmo ângulo da base do braço apontando para ele,
     atan2(60, 160) = 0,35877 rad, para as faces ficarem paralelas aos dedos
     (os dedos fecham na horizontal, perpendicular ao plano do braço). -->
<sdf version="1.9">
  <world name="pick_and_place">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="objeto">
      <pose>0.160 0.060 0.010 0 0 0.35877</pose>
      <link name="link">
        <inertial>
          <mass>0.00992</mass>
          <inertia>
            <ixx>6.61e-7</ixx><iyy>6.61e-7</iyy><izz>6.61e-7</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Publica a pose do objeto em /model/objeto/pose: só para a CONFERÊNCIA
           (o nó do Daniel não usa: o robô real não tem esse sensor). -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>50</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
