<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>braco2_description</name>
  <version>0.1.0</version>
  <description>Descrição (URDF + malhas) do braço do Projeto 2: 4 juntas + garra de mordentes paralelos, servos DYNAMIXEL X430. Malhas geradas por cad/malhas_urdf.py (CadQuery); URDF escrito à mão.</description>
  <maintainer email="danion.neros@gmail.com">Daniel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
