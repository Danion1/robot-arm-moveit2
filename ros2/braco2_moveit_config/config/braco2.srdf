<?xml version="1.0" encoding="UTF-8"?>
<!-- ARQUIVO GERADO por cad/gerar_moveit_config.py: não editar à mão.
     As poses nomeadas vêm de config/poses_nomeadas.xml (escritas pelo Daniel). -->
<robot name="braco2">

  <!-- Grupo de planejamento do braço: a cadeia da base até o TCP. -->
  <group name="braco">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>

  <!-- A garra: só a junta comandada; a espelho (mimic) vem junto sozinha. -->
  <group name="garra">
    <joint name="junta_garra"/>
  </group>

  <end_effector name="garra_ee" parent_link="tcp" group="garra" parent_group="braco"/>

  <!-- Poses nomeadas (Daniel) -->
  <group_state name="zero" group="braco">
    <joint name="junta_base" value="0" />
    <joint name="junta_ombro" value="0" />
    <joint name="junta_cotovelo" value="0" />
    <joint name="junta_punho" value="0" />
  </group_state>
  <group_state name="pronto" group="braco">
    <joint name="junta_base" value="0" />
    <joint name="junta_ombro" value="1.0472" />
    <joint name="junta_cotovelo" value="-1.48353" />
    <joint name="junta_punho" value="-1.13446" />
  </group_state>
  <group_state name="pegar_na_mesa" group="braco">
    <joint name="junta_base" value="0.34907" />
    <joint name="junta_ombro" value="0.69813" />
    <joint name="junta_cotovelo" value="-1.22173" />
    <joint name="junta_punho" value="-1.0472" />
  </group_state>
  <group_state name="alto" group="braco">
    <joint name="junta_base" value="-0.5236" />
    <joint name="junta_ombro" value="1.22173" />
    <joint name="junta_cotovelo" value="-0.69813" />
    <joint name="junta_punho" value="-0.34907" />
  </group_state>
  <group_state name="garra_aberta" group="garra">
    <joint name="junta_garra" value="0.02" />
  </group_state>
  <group_state name="garra_fechada" group="garra">
    <joint name="junta_garra" value="0" />
  </group_state>

  <!-- Pares que o planejador não precisa checar. Os demais PODEM colidir
       e continuam sendo checados (10000 poses sorteadas, caixas de colisão). -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="mordente_cima" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="mordente_baixo" reason="Adjacent"/>
  <!-- mordente_cima x mordente_baixo: mesma junta (mimic); fechados se encostam de propósito -->
  <disable_collisions link1="mordente_cima" link2="mordente_baixo" reason="Default"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link1" link2="link4" reason="Never"/>
  <disable_collisions link1="link1" link2="mordente_cima" reason="Never"/>
  <disable_collisions link1="link1" link2="mordente_baixo" reason="Never"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link2" link2="mordente_cima" reason="Never"/>
  <disable_collisions link1="link2" link2="mordente_baixo" reason="Never"/>
  <disable_collisions link1="link3" link2="mordente_cima" reason="Never"/>
  <disable_collisions link1="link3" link2="mordente_baixo" reason="Never"/>
</robot>
